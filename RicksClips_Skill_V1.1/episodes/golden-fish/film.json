 "sentences": [
  {
   "text": "একদিন এক গরিব জেলে নদীতে জাল ফেলল।",
   "words": [
    0,
    6
   ],
   "subject": "hero",
   "show": [
    "hero",
    "partner",
    "other",
    "field",
    "net"
   ],
   "nouns": [
    {
     "word": "একদিন",
     "at": {
      "s": 1.21
     },
     "show": "net"
    }
   ]
  },
  {
   "text": "সে ভেবেছিল আজও কিছু পাবে না।",
   "words": [
    7,
    12
   ],
   "subject": "hero",
   "show": [
    "hero",
    "partner",
    "other",
    "field"
   ],
   "nouns": []
  },
  {
   "text": "হঠাৎ জালে একটা সোনার মাছ আটকে গেল।",
   "words": [
    13,
    19
   ],
   "subject": "partner",
   "show": [
    "hero",
    "partner",
    "other",
    "field",
    "net"
   ],
   "nouns": [
    {
     "word": "হঠাৎ",
     "at": {
      "s": 5.8
     },
     "show": "net"
    }
   ]
  },
  {
   "text": "জেলে অবাক হয়ে মাছটা দেখল।",
   "words": [
    20,
    24
   ],
   "subject": "hero",
   "show": [
    "hero",
    "partner",
    "other",
    "field",
    "fish"
   ],
   "nouns": [
    {
     "word": "জেলে",
     "at": {
      "s": 7.98
     },
     "show": "fish"
    }
   ]
  },
  {
   "text": "মাছটা বলল, আমাকে ছেড়ে দাও।",
   "words": [
    25,
    29
   ],
   "subject": "partner",
   "show": [
    "hero",
    "partner",
    "other",
    "field",
    "fish"
   ],
   "nouns": [
    {
     "word": "মাছটা",
     "at": {
      "s": 9.9
     },
     "show": "fish"
    }
   ]
  },
  {
   "text": "জেলে মাছটাকে ছেড়ে দিল।",
   "words": [
    30,
    33
   ],
   "subject": "hero",
   "show": [
    "hero",
    "partner",
    "other",
    "field",
    "fish"
   ],
   "nouns": [
    {
     "word": "জেলে",
     "at": {
