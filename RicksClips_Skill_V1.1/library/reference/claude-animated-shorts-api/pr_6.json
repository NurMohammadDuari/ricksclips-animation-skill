    "followers_url": "https://api.github.com/users/a2zrr/followers",
    "following_url": "https://api.github.com/users/a2zrr/following{/other_user}",
    "gists_url": "https://api.github.com/users/a2zrr/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/a2zrr/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/a2zrr/subscriptions",
    "organizations_url": "https://api.github.com/users/a2zrr/orgs",
    "repos_url": "https://api.github.com/users/a2zrr/repos",
