  "title": "Delete Remotion bundles after rendering to stop the temp folder filling up",
  "user": {
    "login": "a2zrr",
    "id": 135616760,
    "node_id": "U_kgDOCBVY-A",
    "avatar_url": "https://avatars.githubusercontent.com/u/135616760?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/a2zrr",
